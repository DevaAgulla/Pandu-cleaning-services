# ---------------------------------------------------------------------------
# PANDU CLEANING SERVICES - ENVIRONMENT CONFIGURATION
# Copy this file to `.env` and fill in the real values.
# ---------------------------------------------------------------------------

# ----------------------------- SERVER --------------------------------------
PORT=3000
NODE_ENV=development

# ----------------------------- BUSINESS ------------------------------------
# Public business details shown on the site (safe to expose to the browser).
BUSINESS_NAME=Pandu Cleaning Services
BUSINESS_TAGLINE=Spotless Spaces, Every Single Time

# Phone number used by the "Call Now" buttons.
# CONTACT_PHONE      -> raw number used to build the tel: link (digits, optional +)
# CONTACT_PHONE_TEXT -> pretty version displayed on screen
CONTACT_PHONE=919191
CONTACT_PHONE_TEXT=919191

# WhatsApp number (digits only, with country code). Leave blank to hide the button.
CONTACT_WHATSAPP=919191

CONTACT_EMAIL=hello@panducleaning.com
CONTACT_ADDRESS=Plot 21, Gachibowli Main Road, Hyderabad, Telangana 500032
BUSINESS_HOURS=Mon - Sun : 7:00 AM - 9:00 PM

# ----------------------------- MAIL ----------------------------------------
# MAIL_TRANSPORT decides how mail is sent:
#   smtp    -> generic SMTP server (use MAIL_HOST / MAIL_PORT / MAIL_SECURE)
#   service -> a well-known provider handled by Nodemailer (set MAIL_SERVICE)
#   console -> no mail is sent, the payload is printed to the terminal (dev/testing)
MAIL_TRANSPORT=console

# Used when MAIL_TRANSPORT=service  (e.g. gmail, outlook, yahoo, zoho, hotmail)
MAIL_SERVICE=gmail

# Used when MAIL_TRANSPORT=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
# true for port 465 (implicit TLS), false for 587 (STARTTLS)
MAIL_SECURE=false

# Credentials of the mailbox that SENDS the booking mails
MAIL_USER=your-sender@gmail.com
MAIL_PASS=your-app-password-here

# From header. If MAIL_FROM is empty, MAIL_USER is used instead.
MAIL_FROM_NAME=Pandu Cleaning Services Website
MAIL_FROM=your-sender@gmail.com

# Where booking requests are delivered (comma separated for multiple recipients)
MAIL_TO=bookings@panducleaning.com

# Optional: comma separated CC / BCC
MAIL_CC=
MAIL_BCC=

# Subject prefix for every booking mail
MAIL_SUBJECT_PREFIX=[New Booking Request]

# Send an auto-reply acknowledgement to the customer (true/false)
MAIL_SEND_CUSTOMER_COPY=true

# Reject self-signed / invalid TLS certs. Set to false only for local test servers.
MAIL_TLS_REJECT_UNAUTHORIZED=true

# ----------------------------- DATABASE ------------------------------------
# Postgres connection string (Neon, Render, Supabase, Railway...).
# Leave EMPTY for local development: the app then uses an embedded PGlite
# database stored in .data/ so it runs with no setup.
# ALWAYS set this in production - a free host wipes the filesystem on deploy.
# Example: postgresql://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
DATABASE_SSL=true

# Skip TLS certificate verification. Leave false - Neon, Render and Supabase all
# present valid certificates. Only set true for a host with a self-signed cert.
DATABASE_SSL_INSECURE=false

# ------------------------------- ADMIN -------------------------------------
# Admin panel lives at /admin
ADMIN_USERNAME=admin1234

# bcrypt hash of the admin password - NEVER the password itself.
# Set it with:  npm run set-admin-password -- "your password"
ADMIN_PASSWORD_HASH=

# Long random string that signs the admin session cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# How long an admin stays signed in
ADMIN_SESSION_HOURS=8
